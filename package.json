{
  "name": "scrapeforge",
  "version": "1.0.15",
  "description": "Autonomous Lead Generation Engine",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build:react": "cd frontend && npm run build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "node -e \"const fs=require('fs'); try { fs.rmSync('dist-release', {recursive: true, force: true}); } catch(e) {}\" && npm run build:react && node -e \"const fs=require('fs'); fs.cpSync('frontend/dist', 'dist', {recursive: true});\" && npm run build:electron && electron-builder --win",
    "save": "git add . && git commit -m \"code save\" && git push origin main",
    "release": "node scripts/push.js"
  },
  "build": {
    "appId": "com.vssgowritech.scrapeforge",
    "productName": "ScrapeForge",
    "asar": false,
    "directories": {
      "output": "dist-release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "luckyandeee",
        "repo": "scrapeforge"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "frontend/public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "frontend/public/icon.ico",
      "uninstallerIcon": "frontend/public/icon.ico",
      "installerHeader": "frontend/public/installer/header.bmp",
      "installerSidebar": "frontend/public/installer/sidebar.bmp",
      "uninstallerSidebar": "frontend/public/installer/sidebar.bmp",
      "license": "license.txt",
      "include": "build/installer.nsh"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/playwright-core/",
        "to": "playwright-core",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.18.1",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "json2csv": "^6.0.0-alpha.2",
    "mongodb": "^7.5.0",
    "ollama": "^0.6.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.61.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
